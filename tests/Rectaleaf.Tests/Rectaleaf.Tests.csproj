<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rectaleaf\Rectaleaf.csproj" />
    <ProjectReference Include="..\..\src\Rectaleaf.Roslyn\Rectaleaf.Roslyn.csproj" />
    <ProjectReference Include="..\..\src\Rectaleaf.Reflection\Rectaleaf.Reflection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Cases\**\*.cs" />
    <None Include="Cases\**\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Cases\**\*.expected.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
